# Copy to .env and fill in what you have. .env is git-ignored. Never paste these values into chat.

# --- Solana data (Phase 1) ---------------------------------------------------
# Free public RPC works for development. For production use a paid provider, e.g. Helius:
#   SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
# SOLANA_RPC_WS defaults to the HTTP URL with ws(s)://
# SOLANA_RPC_WS=
# processed is ~0.5 s faster but can include transactions that later drop; confirmed is safer.
COMMITMENT=confirmed
# Check each streamed transaction's status before using it. Leave off on the public RPC (its status lookups lag
# the stream by ~15 s and get rate-limited); try it on a paid RPC. Duplicate events are dropped either way.
VERIFY_TXS=false

# --- Storage -----------------------------------------------------------------
DB_PATH=data/observer.db
# Raw trades to keep: curve (bonding curve only), all (adds PumpSwap, ~15x more rows), none.
STORE_TRADES=curve
TRADE_RETENTION_DAYS=14
POSITION_RETENTION_DAYS=7
# Pause raw trade writes when free disk drops below this (aggregates keep updating).
MIN_FREE_DISK_GB=3

# --- Coin metadata -----------------------------------------------------------
# Fetch description/image/socials for coins reaching this many organic buyers...
METADATA_MIN_BUYERS=8
# ...and this share of all launches at launch time. 1 (every launch) keeps launch-trait analysis unbiased.
METADATA_SAMPLE_RATE=1
IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/,https://gateway.pinata.cloud/ipfs/,https://4everland.io/ipfs/,https://ipfs.filebase.io/ipfs/

# Optional Jupiter API key (portal.jup.ag); without it the free lite price API is used and rate-limits.
# JUPITER_API_KEY=

LOG_LEVEL=info

# --- Later phases (not used yet) -------------------------------------------------
# Phase 2 narrative engine and coin designer
# ANTHROPIC_API_KEY=
# X_BEARER_TOKEN=
# IMAGE_API_KEY=
# Phase 4 approvals and alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Launch wallet and sending (src/live/venue.ts) ------------------------------
# Live mode: path to the launch wallet's keypair file (Solana CLI JSON) on this machine. The file itself never goes
# in .env or chat, and the bot never prints it. Keep it outside the repo or under keys/ (git-ignored).
# LAUNCH_KEYPAIR_PATH=
# Dry mode needs only the wallet's public key (it simulates against mainnet and never signs). When both are set they
# must be the same wallet. Simulation needs the wallet to exist on mainnet with enough SOL for the dev buy.
# LAUNCH_PUBKEY=
# Priority fee for launches and sells, micro-lamports per compute unit, charged on the unit limit (a launch asks for
# what its preflight used plus 10%, about 240,000; a sell 150,000). 200000 = about 0.00005 SOL per launch. Max 50000000.
PRIORITY_MICROLAMPORTS=200000
# Optional Helius Sender (https://www.helius.dev/docs/sending-transactions/sender): launches and sells are also sent
# here, each with a tip to one of Sender's tip accounts. Without an API key Sender allows 1 request per second per IP;
# add ?api-key=... for more. Leave unset to send through SOLANA_RPC_HTTP only (no tip).
# SENDER_URL=https://sender.helius-rpc.com/fast
# Sender tip per transaction, lamports (5000 to 50000000). Sender's priority routing wants 1000000 (0.001 SOL) or more;
# smaller tips are accepted but sent best-effort on fewer paths.
SENDER_TIP_LAMPORTS=200000
