{
  "name": "memecoin-bot",
  "version": "0.1.0",
  "private": true,
  "description": "pump.fun market observer, wallet intelligence and (later) narrative-driven coin launcher",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "observe": "node --disable-warning=ExperimentalWarning src/cli/observe.ts",
    "report": "node --disable-warning=ExperimentalWarning src/cli/report.ts",
    "inspect": "node --disable-warning=ExperimentalWarning src/cli/inspect.ts",
    "update-idl": "node src/cli/updateIdl.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "devs": "node --disable-warning=ExperimentalWarning src/cli/devs.ts",
    "backfill-launchers": "node --disable-warning=ExperimentalWarning src/cli/backfillLaunchers.ts",
    "wallet-history": "node --disable-warning=ExperimentalWarning src/cli/walletHistory.ts",
    "simulate": "node --disable-warning=ExperimentalWarning src/cli/simulate.ts",
    "backfill-metadata": "node --disable-warning=ExperimentalWarning src/cli/backfillMetadata.ts",
    "traits": "node --disable-warning=ExperimentalWarning src/cli/traits.ts",
    "export-launches": "node --disable-warning=ExperimentalWarning src/cli/exportLaunches.ts",
    "postmortem": "node --disable-warning=ExperimentalWarning src/cli/postmortem.ts",
    "export-paths": "node --disable-warning=ExperimentalWarning src/cli/exportPaths.ts",
    "paper-fork": "node --disable-warning=ExperimentalWarning src/cli/paperFork.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@solana/kit": "^8.5.0",
    "@solana/web3.js": "^1.98.2",
    "litesvm": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
